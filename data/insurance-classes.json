{
  "_note": "Insurance classes besides the house, for the hackathon demo: the profile fields of each class and the base premiums. The house uses data/catalogue.json and data/home-profile.schema.json. The demo customer and their risks are in data/demo-person.json. Every number is a placeholder.",
  "classes": [
    {
      "class_id": "cottage",
      "name": "Summer cottage",
      "fields": [
        {
          "name": "building_year",
          "kind": "year",
          "description": "Year the cottage was built."
        },
        {
          "name": "heating",
          "kind": "enum",
          "options": [
            "wood",
            "electric",
            "none"
          ],
          "description": "Main heating."
        },
        {
          "name": "water_winterized",
          "kind": "enum",
          "options": [
            "yes",
            "no"
          ],
          "description": "Whether the water pipes are drained for the winter."
        },
        {
          "name": "last_chimney_sweep",
          "kind": "date",
          "description": "Date of the last chimney sweep."
        }
      ]
    },
    {
      "class_id": "boat",
      "name": "Boat",
      "fields": [
        {
          "name": "boat_type",
          "kind": "enum",
          "options": [
            "motorboat",
            "sailboat",
            "rowing_boat"
          ],
          "description": "Type of boat."
        },
        {
          "name": "last_engine_service",
          "kind": "date",
          "description": "Date of the last engine service."
        },
        {
          "name": "winter_storage",
          "kind": "enum",
          "options": [
            "indoor",
            "outdoor_covered",
            "outdoor_uncovered"
          ],
          "description": "Where the boat spends the winter."
        }
      ]
    },
    {
      "class_id": "car",
      "name": "Car",
      "fields": [
        {
          "name": "model_year",
          "kind": "year",
          "description": "Model year of the car."
        },
        {
          "name": "winter_tyres_year",
          "kind": "year",
          "description": "Year the winter tyres were bought."
        },
        {
          "name": "last_service",
          "kind": "date",
          "description": "Date of the last service."
        }
      ]
    },
    {
      "class_id": "dog",
      "name": "Dog",
      "fields": [
        {
          "name": "breed_size",
          "kind": "enum",
          "options": [
            "small",
            "medium",
            "large"
          ],
          "description": "Size class of the breed."
        },
        {
          "name": "birth_year",
          "kind": "year",
          "description": "Year the dog was born."
        },
        {
          "name": "vaccinations_valid",
          "kind": "enum",
          "options": [
            "yes",
            "no"
          ],
          "description": "Whether the vaccinations are up to date."
        }
      ]
    }
  ],
  "base_premiums_eur": {
    "house": 900,
    "cottage": 450,
    "boat": 300,
    "car": 700,
    "dog": 350
  }
}
