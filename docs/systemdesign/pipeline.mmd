%%{init: {"theme": "base", "themeVariables": {"fontSize": "15px", "lineColor": "#44546a"}}}%%
flowchart TD
    up["<b>1. Upload</b><br/>check PDF magic bytes and 20 MB limit<br/>save PDF, queue document and job"]
    take["<b>2. Worker takes job</b><br/>status: running"]
    ext["<b>3. Extract</b> · stage: extracting<br/>pypdfium2 reads text<br/>Ollama returns field candidates"]
    merge["<b>4. Merge</b><br/>replace known fields, source: document<br/>build evidence, save profile"]
    match["<b>5. Match</b> · stage: matching<br/>catalogue entries vs profile"]
    write["<b>6. Write</b> · stage: writing<br/>Ollama writes why and benefit"]
    prop{"Model proposed<br/>unmatched ids?"}
    write2["Second write call<br/>for ids that survive the code filter<br/>llm_proposed = true"]
    save["Save risk_texts"]
    done(["<b>7. Done</b><br/>job done, document processed"])
    fail(["<b>Failed</b><br/>job and document failed"])

    up --> take --> ext --> merge --> match --> write --> prop
    prop -->|yes| write2 --> save
    prop -->|no| save
    save --> done
    ext -.->|"no text layer"| fail
    ext -.->|"output cut:<br/>done_reason length"| fail
    write -.->|"180 s limit"| fail

    classDef code fill:#e3f1e5,stroke:#2e7d32,color:#10300f
    classDef model fill:#fdeede,stroke:#c26a00,color:#3a2100
    classDef end_ok fill:#dff0ff,stroke:#2f5fa7
    classDef end_bad fill:#fde4e4,stroke:#b3261e
    class up,take,merge,match,save code
    class ext,write,write2 model
    class done end_ok
    class fail end_bad
