# Copy to mobile-app/.env (git ignores it). Expo builds these into the app.
# The backend's address as the phone or browser sees it. In a browser on this machine:
# http://localhost:8000. On a phone in Expo Go: http://<your-computer-LAN-IP>:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
# The demo customer token: CUSTOMER_TOKEN in the repo root .env.
EXPO_PUBLIC_API_TOKEN=<customer-token>
