# HTTPS reverse proxy: Caddy gets and renews the certificates itself (Let's Encrypt).
{$APP_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy mobile:80
}

{$DASHBOARD_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy frontend:3000
}
