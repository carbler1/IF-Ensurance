# Copy to .env. Never commit .env.
# Inside docker compose this must be an address the container can reach (not 127.0.0.1), e.g. http://host.docker.internal:11434.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
CORS_ORIGINS=<lovable-preview-url>,<demo-url>
CUSTOMER_TOKEN=<customer-token>
PARTNER_TOKEN=<partner-token>
# The staff dashboard's token for the backend's /v1/admin API.
ADMIN_TOKEN=<admin-token>
# Postgres for docker compose. Only the backend connects to it.
POSTGRES_USER=ilp
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=ilp
# Host ports for docker compose.
BACKEND_PORT=8000
FRONTEND_PORT=3000
MOBILE_PORT=8082
# Public origin of the app demo; the mobile build uses it as the API address.
EXPO_PUBLIC_API_URL=http://localhost:8082
