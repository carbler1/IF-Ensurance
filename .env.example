# Copy to .env. Never commit .env.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
CORS_ORIGINS=<lovable-preview-url>,<demo-url>
CUSTOMER_TOKEN=<customer-token>
PARTNER_TOKEN=<partner-token>
ADMIN_TOKEN=<admin-token>
# Ollama address seen from inside docker compose (default: the host).
OLLAMA_URL_DOCKER=http://host.docker.internal:11434
# Host ports for docker compose.
BACKEND_PORT=8000
FRONTEND_PORT=3000
