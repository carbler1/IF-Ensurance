# Copy to .env. Never commit .env.
# Inside docker compose the address must be reachable from the container (not 127.0.0.1).
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
# Other browser origins allowed to call the API, comma-separated. Not needed for the app demo: nginx serves app and API on one origin.
CORS_ORIGINS=https://app.example.com
CUSTOMER_TOKEN=<customer-token>
# The staff dashboard's token for the backend's /v1/admin API.
ADMIN_TOKEN=<admin-token>
# Postgres for docker compose. Only the backend connects to it.
POSTGRES_USER=ilp
# Must not contain @ / : (it goes unencoded into DATABASE_URL).
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=ilp
# Public origin of the app demo; the mobile build uses it as the API address.
EXPO_PUBLIC_API_URL=http://localhost:8082
# Public domains served by Caddy (ports 80 and 443).
APP_DOMAIN=app.example.com
DASHBOARD_DOMAIN=dashboard.example.com
# Staff dashboard is read-only unless this is 0 or false (turn off when sign-in returns).
DASHBOARD_READONLY=1
